# ---- Client (public, inlined into the bundle) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local-only auth bypass. Ignored in production builds. Leave unset normally.
# VITE_DISABLE_AUTH=true

# ---- Server only (serverless functions; NEVER prefixed VITE_) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local-only API auth bypass. Requires NODE_ENV !== production. Leave unset normally.
# ALLOW_DEV_AUTH_BYPASS=true
